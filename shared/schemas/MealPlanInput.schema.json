{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "weekStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "maxItems": 56,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "slot": {
            "type": "string",
            "enum": [
              "breakfast",
              "lunch",
              "dinner",
              "snack"
            ]
          },
          "recipeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "servings": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "date",
          "slot",
          "title"
        ]
      }
    }
  },
  "required": [
    "weekStart",
    "entries"
  ]
}
