{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "displayName": {
      "type": "string",
      "maxLength": 120
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "adult",
        "child",
        "staff"
      ]
    }
  },
  "required": [
    "role"
  ]
}
