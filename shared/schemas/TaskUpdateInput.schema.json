{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "category": {
      "type": "string",
      "maxLength": 60
    },
    "priority": {
      "default": "normal",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "dueAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "assigneeUid": {
      "type": "string",
      "maxLength": 128
    },
    "recurrence": {
      "type": "object",
      "properties": {
        "freq": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "byWeekday": {
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "byMonthDay": {
          "type": "integer",
          "minimum": -1,
          "maximum": 31
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "until": {
          "type": "string"
        }
      },
      "required": [
        "freq"
      ]
    },
    "checklist": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "maxLength": 200
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "done"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done",
        "cancelled"
      ]
    }
  }
}
