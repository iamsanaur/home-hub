{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "listId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "quantity": {
      "default": 1,
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100000
    },
    "unit": {
      "default": "pcs",
      "type": "string",
      "maxLength": 20
    },
    "category": {
      "default": "Other",
      "type": "string",
      "maxLength": 60
    },
    "preferredBrand": {
      "type": "string",
      "maxLength": 80
    },
    "preferredStore": {
      "type": "string",
      "maxLength": 80
    },
    "estimatedPriceMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "listId",
    "name"
  ]
}
