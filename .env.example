# HomeHub AI — environment template. PLACEHOLDERS ONLY. Never commit real values.
# Local development needs NONE of these: the apps and backend run against the Firebase Emulator Suite.

# --- Cloud Functions (production) — set as Firebase params/secrets, not in this file ---
# firebase functions:secrets:set HERMES_API_KEY            # server Hermes API server key (fallback runtime)
# firebase functions:secrets:set HOMEHUB_MCP_SERVICE_KEY   # key the server Hermes uses to call the HomeHub MCP server
# firebase functions:secrets:set MODEL_API_KEY             # provider key used by the Hermes Mobile model proxy
HERMES_API_URL=https://hermes.internal.example:8642        # private network address of the server Hermes
MODEL_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # any OpenAI-compatible endpoint
MODEL_SIMPLE=replace-with-economical-model-id
MODEL_COMPLEX=replace-with-reasoning-model-id
MODEL_MAX_CALLS_PER_WORKFLOW=16
MODEL_MAX_TOKENS_PER_WORKFLOW=120000
MODEL_PRICING={}                                           # optional: {"model-id":{"inputPerMTokMicros":0,"outputPerMTokMicros":0}}
AGENT_RUNS_PER_HOUR=30
PUBLIC_GATEWAY_URL=https://asia-south1-<project>.cloudfunctions.net/api   # used for the OpenRouter sign-in callback
PLUGIN_CALLS_PER_HOUR=300

# --- Bring-your-own model accounts --- (keys are stored per account in Secret Manager; nothing to set here)
# Without MODEL_API_KEY, members must connect their own account (Settings → AI model).

# --- Alexa (docs/alexa.md) ---
# firebase functions:secrets:set ALEXA_OAUTH_CLIENT_SECRET  # account-linking client secret (you choose it; paste into the Alexa console)
# firebase functions:secrets:set ALEXA_FORWARDER_SECRET     # HMAC shared with the AWS Lambda forwarder
# firebase functions:secrets:set LWA_CLIENT_SECRET          # skill's Login with Amazon secret (Alexa console → Permissions)
ALEXA_SKILL_ID=amzn1.ask.skill.replace-me
ALEXA_OAUTH_CLIENT_ID=homehub-alexa
ALEXA_REDIRECT_URIS=https://pitangui.amazon.com/api/skill/link/REPLACE,https://layla.amazon.com/api/skill/link/REPLACE,https://alexa.amazon.co.jp/api/skill/link/REPLACE
HOMEHUB_WEB_API_KEY=replace-with-web-api-key               # used by the account-linking sign-in page
LWA_CLIENT_ID=amzn1.application-oa2-client.replace-me
ENFORCE_APP_CHECK=true
FCM_ENABLED=true

# --- Hermes server profile (~/.hermes/profiles/homehub-hermes/.env) — see agents/hermes/config/env.example ---

# --- Native apps ---
# Android: put google-services.json in android/app/ (git-ignored). Optional: -Phomehub.gatewayUrl=https://...
# iOS: put GoogleService-Info.plist in ios/HomeHub/ (git-ignored) and add HomeHubGatewayURL to Info.plist if not default.
