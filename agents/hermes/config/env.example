# ~/.hermes/profiles/homehub-hermes/.env — PLACEHOLDERS ONLY. Never commit real values.
API_SERVER_ENABLED=true
API_SERVER_KEY=replace-with-long-random-secret          # same value as HERMES_API_KEY in Cloud Functions secrets
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
HOMEHUB_MCP_URL=http://127.0.0.1:5001/demo-homehub/asia-south1/mcp   # production: https://<region>-<project>.cloudfunctions.net/mcp
HOMEHUB_MCP_SERVICE_KEY=replace-with-long-random-secret # same value as HOMEHUB_MCP_SERVICE_KEY in Cloud Functions secrets
# Model provider credentials: configure with `homehub-hermes model` / `hermes -p homehub-hermes auth` — not here.
